# secrets
ernie.env
ernie-test.env
# a second tester's copy, whatever they name it
*.env

# databases -- never commit; `*.db.*` also catches dated copies like
# ernie.db.pre-migrate-20260828-1307, which slipped past *.db once
*.db
*.db-*
*.db.*

dump/
logs/
backups/
__pycache__/

# stray `git init`, not a real backup
ernie-test-backup/

# a clone of this repo made inside itself, following TESTING.md step 2
/ernie-test/

# the exe. `build/` is PyInstaller's scratch and `dist/Ernie/` is 96 MB over
# 87 files, rebuilt from the tree in 40 seconds by `python build.py`.
build/
dist/

# written by build.py for the length of one build so the frozen copy can name
# its commit, and removed again afterwards -- a stamp left in the tree makes a
# *source* run claim to be a build that does not exist. Ignored so an
# interrupted build cannot commit one.
build_commit.txt
